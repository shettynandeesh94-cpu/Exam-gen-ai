# ExamGen AI Pro - Backend Environment Variables
PORT=5000

# SQL Database URL (Connection string)
DATABASE_URL=your_database_url_here

# MongoDB Connection String (If applicable)
MONGO_URI=your_mongo_uri_here

# JSON Web Token Secret
JWT_SECRET=your_jwt_signing_secret_here
JWT_EXPIRE=7d

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMTP Email Dispatch configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
FROM_NAME="ExamGen AI Pro"
FROM_EMAIL=your_email@gmail.com

# Google OAuth Client
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
